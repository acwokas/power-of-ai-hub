# Public site URL (used for canonical, OG, sitemap). Defaults to the production
# domain in astro.config.mjs; override here only for preview/staging builds.
SITE_URL=https://democratising.ai

# Google Tag Manager container ID (build-time, inlined into the static HTML).
# Analytics is GTM only: the GA4 Measurement ID lives INSIDE the GTM container
# (GA4 Configuration tag), never as a separate GA4_ID env var. Set the real
# value as a Cloudflare Pages Production environment variable, not here.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Backend AI for tools that need server-side LLM streaming
# (Decision Simulation, and future Govern/Define/Elevate tools).
# Set this as a Cloudflare Pages secret (Settings -> Environment variables ->
# Production -> Add variable, marked as encrypted). Never expose to client JS.
# OPENAI_API_KEY=sk-...
# Optional model override (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
