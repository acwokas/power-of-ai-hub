<section class="draft-preferences" aria-label="Saved drafts"><label><input id="remember-edge" type="checkbox"/> Remember future specialist-tool edits for seven days on this device</label><p>Otherwise, drafts stay in this tab. Shared devices should use the default. Before You Send has its own save setting.</p><button id="clear-edge-drafts">Clear saved EDGE drafts</button><p id="draft-preference-status" role="status"></p><a href="/privacy">Privacy and storage details</a></section>
<script is:inline>
(()=>{const checkbox=document.getElementById('remember-edge'),status=document.getElementById('draft-preference-status');try{checkbox.checked=localStorage.getItem('edge-remember-drafts-v1')==='yes'}catch{}checkbox.onchange=()=>{try{if(checkbox.checked)localStorage.setItem('edge-remember-drafts-v1','yes');else{localStorage.removeItem('edge-remember-drafts-v1');for(const key of Object.keys(localStorage))if(key.startsWith('edge-v2:'))localStorage.removeItem(key);}status.textContent=checkbox.checked?'Future edits will be kept for up to seven days.':'Seven-day saving is off. Current tab notes remain.';}catch{status.textContent='This browser could not change saving preferences.'}};document.getElementById('clear-edge-drafts').onclick=()=>{if(!confirm('Clear saved EDGE drafts on this device? Download anything you want to keep first. Current visible notes remain until you leave or refresh.'))return;for(const store of [localStorage,sessionStorage])for(const key of Object.keys(store))if(/^(edge-|define-|simulate-)/.test(key))store.removeItem(key);checkbox.checked=false;status.textContent='Saved EDGE drafts cleared. Current visible notes remain.'};})();
</script><style>.draft-preferences{max-width:900px;margin:40px auto;padding:24px;font:14px/1.5 Arial,sans-serif;border-top:1px solid #7a8989;color:#152b39}.draft-preferences label,.draft-preferences button,.draft-preferences a{display:block;padding:12px 0}.draft-preferences button{cursor:pointer;background:none;border:0;text-decoration:underline}.draft-preferences :focus-visible{outline:3px solid #9c571f}</style>