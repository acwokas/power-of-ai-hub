---
import { loadDataUtilities, loadTradeChecked } from '../lib/data-utilities';
import { consumerSites } from '../lib/consumer-network';
import EcosystemCard from './EcosystemCard.astro';

// Logo restore 2026-08-17: these three logo fields, and the img block
// below in the regions card, were dropped when this branch was built from
// astro-migration (commit d093aee) rather than from sites-own-favicons,
// an unmerged branch with 5 commits (a9547f7..d3a3562) that had already
// given each regional site its own favicon. Restored from that branch via
// `git show sites-own-favicons:...`, not re-sourced or regenerated.
const regions = [
  {
    region: 'Asia',
    title: 'AI in Asia',
    description:
      'Insight, context, and perspective on AI, business, regulation, and culture. For people who want understanding before action.',
    url: 'https://www.aiinasia.com',
    logo: '/brand/sites/aiinasia.png',
  },
  {
    region: 'Arabia',
    title: 'AI in Arabia',
    description:
      "The Arab world's independent home for AI news, analysis, and practical guides. Written for the region, by people who understand it.",
    url: 'https://www.aiinarabia.com',
    logo: '/brand/sites/aiinarabia.png',
  },
  {
    region: 'Europe',
    title: 'AI in Europe',
    description:
      "Europe's daily AI brief covering the EU, UK, and Switzerland. Primary sources, British English, no hype.",
    url: 'https://www.aiineurope.co',
    logo: '/brand/sites/aiineurope.png',
  },
];

// New order per Adrian: TradeChecked leads (it reads the same registers as
// the data utility layer but answers a lookup), then PromptAndGo, then EDGE.
const tools = [
  {
    category: 'Verify',
    title: 'TradeChecked',
    description:
      'Reads the same BCA and NEA public registers as the data utility layer, but built to answer one lookup rather than to browse a dataset: enter a UEN, get back whether that contractor holds a current licence, right now.',
    // Figures come from tradechecked.sg/data/coverage.json at build time,
    // spread in below. They were typed here until 2026-08-21, dated
    // 7 August, and nothing on this site could tell whether they were
    // still true. See src/lib/data-utilities.ts.
    cta: 'Check a licence',
    url: 'https://tradechecked.sg',
    external: true,
    logo: '/brand/tradechecked-mark.svg',
  },
  {
    category: 'Prompt',
    title: 'PromptAndGo',
    description:
      'AI prompts that speak Asia fluently. Built for every language. Cultural register, not just translation.',
    cta: 'Use PromptAndGo',
    url: 'https://promptandgo.ai',
    external: true,
    logo: '/brand/sites/promptandgo.png',
  },
  {
    category: 'Framework',
    title: 'EDGE Framework',
    description:
      'Applied intelligence, operationalised. Twelve session-based tools across Evaluate, Define, Govern, and Elevate. Diagnose maturity, simulate decisions, rehearse governance, engineer prompts. Privacy first, no signup.',
    cta: 'Open the framework',
    url: '/tools',
    external: false,
    logo: '/brand/edge-mark-transparent.svg',
  },
];
/*
 * Both awaited at the top of the component so the build fails here, in
 * one place, if any of the four sites cannot be read. Astro renders this
 * frontmatter at build time; nothing below reaches a browser.
 */
const [dataUtilities, tradechecked] = await Promise.all([
  loadDataUtilities(),
  loadTradeChecked(),
]);

// The tools rail carries one card with figures and two without. Merged
// here rather than inside the literal above so the editorial copy and the
// live numbers stay visibly separate.
const toolCards = tools.map((tool) =>
  tool.title === 'TradeChecked' ? { ...tool, ...tradechecked } : tool,
);

---
<section id="ecosystem" class="py-20 md:py-28 bg-background border-t border-border/60">
  <div class="container mx-auto px-6 max-w-6xl">
    <header class="max-w-3xl mb-14 md:mb-20">
      <p class="eyebrow mb-5">The ecosystem</p>
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl font-black tracking-tight">
        One ecosystem. Different roles.
      </h2>
      <div class="mt-6 text-lg md:text-xl text-foreground leading-relaxed">
        <p>Each part of the ecosystem serves a specific purpose.</p>
      </div>
    </header>

    <div class="mb-20 md:mb-24" data-section="regional-network">
      <div class="flex items-baseline justify-between border-b border-border pb-4 mb-8">
        <h3 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">
          The regional network
        </h3>
        <span class="eyebrow hidden md:block">Editorial</span>
      </div>

      <div class="grid gap-px bg-border md:grid-cols-3 border border-border">
        {regions.map((region) => (
          <a
            href={region.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-background hover:bg-card transition-colors p-7 md:p-8 flex flex-col"
          >
            <p class="eyebrow mb-6">{region.region}</p>
            <div class="flex items-center gap-3 mb-4">
              {region.logo && (
                <img
                  src={region.logo}
                  alt=""
                  aria-hidden="true"
                  width="40"
                  height="40"
                  class="shrink-0 rounded-full bg-white"
                />
              )}
              <h4 class="font-serif text-3xl md:text-[2rem] font-black tracking-tight leading-[1.1] text-foreground">
                {region.title}
              </h4>
            </div>
            <p class="text-foreground leading-relaxed flex-grow mb-8">
              {region.description}
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all">
              Read the publication
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="mb-20 md:mb-24" data-section="data-utility">
      <div class="flex items-baseline justify-between border-b border-border pb-4 mb-8">
        <h3 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">
          <a href="/data" class="hover:text-accent transition-colors">The data utility layer</a>
        </h3>
        <span class="eyebrow hidden md:block">Verified</span>
      </div>
      <p class="max-w-3xl text-foreground/85 leading-relaxed mb-8">
        Three independent Singapore sites, each reading one named public register: hiring data,
        COE results, statutory deadlines. Datasets you browse, dated and sourced, not asserted.
        <a href="/data" class="text-accent hover:underline">Read how each one works</a>.
      </p>

      <div class="grid gap-6 md:grid-cols-3">
        {dataUtilities.map((site) => (
          <EcosystemCard
            logo={site.logo}
            name={site.name}
            descriptor={site.tagline}
            description={site.description}
            stat={site.stat}
            statLabel={site.statLabel}
            coverageNote={site.coverageNote}
            sourceName={site.sourceName}
            sourceUrl={site.sourceUrl}
            verifiedDate={site.verifiedDate}
            cta={`Visit ${site.name}`}
            url={site.url}
            brand={site.slug}
          />
        ))}
      </div>
    </div>

    <div class="mb-20 md:mb-24" data-section="tools-platforms">
      <div class="flex items-baseline justify-between border-b border-border pb-4 mb-8">
        <h3 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">
          Tools and platforms
        </h3>
        <span class="eyebrow hidden md:block">Applied</span>
      </div>
      <p class="max-w-3xl text-foreground/85 leading-relaxed mb-8">
        Three tools you use rather than browse: put in a UEN, a prompt, or a question, and get a
        specific answer back, not a dataset to explore.
      </p>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {toolCards.map((tool) => (
          <EcosystemCard
            logo={tool.logo}
            name={tool.title}
            descriptor={tool.category}
            description={tool.description}
            stat={tool.stat}
            statLabel={tool.statLabel}
            sourceName={tool.sourceName}
            sourceUrl={tool.sourceUrl}
            verifiedDate={tool.verifiedDate}
            cta={tool.cta}
            url={tool.url}
            external={tool.external}
            brand={tool.title === 'TradeChecked' ? 'tradechecked' : undefined}
          />
        ))}
      </div>
    </div>

    <div data-section="consumer-network">
      <div class="flex items-baseline justify-between border-b border-border pb-4 mb-8">
        <h3 class="font-serif text-2xl md:text-3xl font-bold tracking-tight">
          Life with pets in the city
        </h3>
        <span class="eyebrow hidden md:block">Consumer</span>
      </div>
      <p class="max-w-3xl text-foreground/85 leading-relaxed mb-8">
        Three Singapore publications for pet owners: what to feed, where to go, and which places
        actually welcome a dog or a cat, hand-checked rather than scraped from a directory.
      </p>

      <div class="grid gap-6 md:grid-cols-3">
        {consumerSites.map((site) => (
          <EcosystemCard
            logo={site.logo}
            logoSize={site.slug === 'urbandogowner' ? 56 : 40}
            name={site.name}
            descriptor={site.tagline}
            description={site.description}
            cta={`Read ${site.name}`}
            url={site.url}
          />
        ))}
      </div>
    </div>
  </div>
</section>
