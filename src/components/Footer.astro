---
const currentYear = new Date().getFullYear();
---
<footer class="py-10 md:py-14 px-6 bg-background border-t border-border">
  <div class="container mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8">
        <a href="/" aria-label="democratising.ai home" class="inline-flex items-center gap-3 hover:opacity-80 transition-opacity">
          <img
            src="/brand/democratising-mark-on-navy.svg"
            alt=""
            width="36"
            height="36"
            class="block shrink-0"
            aria-hidden="true"
          />
          <span class="font-serif font-black tracking-tighter text-foreground text-2xl leading-none">
            democratising.ai
          </span>
        </a>
        <a
          href="/tools"
          class="inline-flex items-center gap-2 text-sm text-foreground hover:text-accent transition-colors"
        >
          <img
            src="/brand/edge-mark-transparent.svg"
            alt=""
            width="20"
            height="20"
            class="shrink-0"
            aria-hidden="true"
          />
          EDGE Framework
        </a>
        <a
          href="/data"
          class="inline-flex items-center gap-2 text-sm text-foreground hover:text-accent transition-colors"
        >
          Data utility layer
        </a>
        <a
          href="mailto:hello@democratising.ai"
          class="text-sm text-foreground hover:text-accent transition-colors"
        >
          hello@democratising.ai
        </a>
      </div>
      <p class="text-sm text-foreground">
        &copy; {currentYear} DEMOCRATISING.AI
      </p>
    </div>
  </div>
</footer>
