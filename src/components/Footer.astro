---
const currentYear = new Date().getFullYear();
---
<footer class="py-10 md:py-14 px-6 bg-background border-t border-border">
  <div class="container mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8">
        <span class="font-serif font-black tracking-tighter text-accent text-lg">
          DEMOCRATISING.AI
        </span>
        <a
          href="mailto:hello@democratising.ai"
          class="text-sm text-foreground/70 hover:text-accent transition-colors"
        >
          hello@democratising.ai
        </a>
      </div>
      <p class="text-sm text-foreground/60">
        &copy; {currentYear} DEMOCRATISING.AI
      </p>
    </div>
  </div>
</footer>
