---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  pillar: string;
  description: string;
}

const { title, pillar, description } = Astro.props;

const pillarMark: Record<string, string> = {
  Evaluate: '/brand/edge-mark-evaluate.svg',
  Define: '/brand/edge-mark-define.svg',
  Govern: '/brand/edge-mark-govern.svg',
  Elevate: '/brand/edge-mark-elevate.svg',
};
const markSrc = pillarMark[pillar] ?? '/brand/edge-mark-transparent.svg';
---
<BaseLayout
  title={`${title} - EDGE - DEMOCRATISING.AI`}
  description={description}
>
  <main>
    <section class="bg-background border-b border-border/60">
      <div class="container mx-auto px-6 max-w-3xl py-16 md:py-24">
        <p class="eyebrow mb-5">
          <a href="/" class="hover:text-foreground transition-colors">DEMOCRATISING.AI</a>
          <span class="text-foreground/40 mx-1">/</span>
          <a href="/tools" class="hover:text-foreground transition-colors">EDGE</a>
          <span class="text-foreground/40 mx-1">/</span>
          {pillar}
        </p>
        <div class="flex items-start gap-4 mb-6">
          <img
            src={markSrc}
            alt={`EDGE Framework mark, ${pillar} pillar`}
            width="40"
            height="40"
            class="shrink-0 mt-2 md:w-12 md:h-12"
          />
          <h1 class="font-serif text-4xl md:text-5xl font-black tracking-tight leading-[1.05]">
            {title}
          </h1>
        </div>
        <p class="text-lg md:text-xl text-foreground/85 leading-relaxed mb-10">
          {description}
        </p>
        <div class="rounded-md border border-accent/30 bg-accent/[0.07] px-6 py-5 text-foreground mb-12">
          <p class="eyebrow mb-2">Coming soon</p>
          <p>This tool is being ported into the new hub. The session flow exists and works elsewhere in the ecosystem; we'll switch this page on once the port is complete.</p>
        </div>
        <a href="/tools" class="inline-flex items-center text-accent hover:underline">
          &larr; Back to the EDGE framework
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
