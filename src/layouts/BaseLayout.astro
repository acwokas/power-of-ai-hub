---
import '../styles/global.css';

const SITE_URL = (Astro.site?.toString() || 'https://democratising.ai').replace(/\/$/, '');

// Analytics: Google Tag Manager ONLY. The GA4 Measurement ID is configured
// INSIDE the GTM container (the "GA4 Configuration" / Google Tag, firing on all
// pages), never as a separate GA4_ID env var. The site only ever needs the GTM
// container ID, exposed at build time via PUBLIC_GTM_ID. Locked cross-site rule.
// Default to the live democratising.ai container so analytics work on a plain
// deploy; a PUBLIC_GTM_ID Cloudflare Pages env var still overrides this for
// preview or staging builds. The container ID is public (it ships in the HTML),
// so it is safe to commit as a production default.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || 'GTM-KV37H5CZ';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

// Strip the build's `.html` suffix (build.format: 'file') and any trailing slash
// so the canonical matches the clean URL CF Pages serves and the sitemap emits.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
// Homepage canonical keeps the root slash (https://democratising.ai/); subpages
// stay slash-less to match trailingSlash: 'never' (https://democratising.ai/slug).
const canonicalUrl = canonical || `${SITE_URL}${path === '/' ? '/' : path}`;
const absoluteOg = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {GTM_ID && (
      <!-- Google Tag Manager (GA4 is configured inside the container, not a separate env var) -->
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`} />
      <!-- End Google Tag Manager -->
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#14264C" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700;9..144,900&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:site_name" content="DEMOCRATISING.AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@withthepowerof_ai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'DEMOCRATISING.AI',
      url: 'https://democratising.ai/',
      description: 'An ecosystem of editorial and applied AI, helping people think clearly, act deliberately, and execute with confidence.',
      sameAs: [
        'https://www.aiinasia.com',
        'https://www.aiinarabia.com',
        'https://www.aiineurope.co',
        'https://promptandgo.ai',
        'https://urbandogowner.com',
        'https://payline.sg',
        'https://coewatch.sg',
        'https://tradechecked.sg',
        'https://duedate.sg',
      ],
    })} />

    <style is:global>
      html { scroll-behavior: smooth; }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    {GTM_ID && (
      <!-- Google Tag Manager (noscript) -->
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
      <!-- End Google Tag Manager (noscript) -->
    )}

    <slot />

    <script is:inline>
      // Defensive: ensure mailto: anchors always navigate to the OS mail handler
      // even if a downstream listener (analytics tag, future script, etc.) calls preventDefault.
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="mailto:"]');
        if (!a) return;
        if (e.defaultPrevented) {
          e.stopImmediatePropagation();
          window.location.href = a.href;
        }
      }, true);
    </script>
  </body>
</html>
