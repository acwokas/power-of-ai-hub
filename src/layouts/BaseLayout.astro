---
import '../styles/global.css';

const SITE_URL = (Astro.site?.toString() || 'https://power-of-ai-hub-astro.pages.dev').replace(/\/$/, '');

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical || `${SITE_URL}${path === '/' ? '' : path}`;
const absoluteOg = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700;9..144,900&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:site_name" content="DEMOCRATISING.AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@withthepowerof_ai" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'DEMOCRATISING.AI',
      url: 'https://democratising.ai/',
      logo: `${SITE_URL}/favicon.png`,
      description: 'An ecosystem of editorial and applied AI, helping people think clearly, act deliberately, and execute with confidence.',
      sameAs: [
        'https://www.aiinasia.com',
        'https://www.aiinarabia.com',
        'https://www.aiineurope.co',
        'https://promptandgo.ai',
        'https://aiacademy.asia',
      ],
    })} />

    <style is:global>
      html { scroll-behavior: smooth; }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <slot />

    <script is:inline>
      // Defensive: ensure mailto: anchors always navigate to the OS mail handler
      // even if a downstream listener (analytics tag, future script, etc.) calls preventDefault.
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="mailto:"]');
        if (!a) return;
        if (e.defaultPrevented) {
          e.stopImmediatePropagation();
          window.location.href = a.href;
        }
      }, true);
    </script>
  </body>
</html>
