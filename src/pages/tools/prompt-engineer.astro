---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import PromptEngineer from '../../components/PromptEngineer.tsx';
---
<BaseLayout
  title="Prompt Engineer - EDGE Elevate - DEMOCRATISING.AI"
  description="Rewrite any prompt for the platform you're sending it to. Five formats, side-by-side comparison, all client-side. No signup, no storage."
>
  <main>
    <section class="bg-background border-b border-border/60">
      <div class="container mx-auto px-6 max-w-3xl py-16 md:py-24">
        <p class="eyebrow mb-5">
          <a href="/" class="hover:text-foreground transition-colors">DEMOCRATISING.AI</a>
          <span class="text-foreground/40 mx-1">/</span>
          <a href="/tools" class="hover:text-foreground transition-colors">EDGE</a>
          <span class="text-foreground/40 mx-1">/</span>
          Elevate
        </p>
        <div class="flex items-start gap-4 mb-6">
          <img
            src="/brand/edge-mark-elevate.svg"
            alt="EDGE Framework mark, Elevate pillar"
            width="40"
            height="40"
            class="shrink-0 mt-2 md:w-12 md:h-12"
          />
          <h1 class="font-serif text-4xl md:text-5xl lg:text-[3.25rem] font-black tracking-tight leading-[1.05]">
            Prompt Engineer
          </h1>
        </div>
        <p class="text-lg md:text-xl text-foreground/85 leading-relaxed mb-6">
          Paste any prompt and rewrite it for the platform you're sending it to. Side-by-side comparison, copy in one click.
        </p>
        <div class="flex items-start gap-3 text-sm text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 text-accent shrink-0" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>All processing happens in your browser. Prompts are never sent to a server or stored anywhere.</span>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-20">
      <div class="container mx-auto px-6 max-w-3xl">
        <PromptEngineer client:load />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
