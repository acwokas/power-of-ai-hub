---
import EdgeHead from '../../components/EdgeHead.astro';
import ToolNavigation from '../../components/ToolNavigation.astro';
// Isolated unified rehearsal preview.
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Conversation Practice | EDGE</title><link rel="stylesheet" href="/journey/journey.css"><style is:global>.practice-modes{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.practice-modes [aria-pressed=true]{background:#152b39;color:white}.practice-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:50px;padding:25px 0 55px}.practice-setup textarea{min-height:120px}.practice-setup input{width:100%;padding:12px;border:1px solid #bec9c1;border-radius:8px;background:#fcfcf7}.practice-setup label{display:block;font-weight:600;margin-top:18px}.practice-setup small{font-size:12px;display:block;color:#5c6b70}.dialogue{min-height:220px;padding:20px 0}.message{padding:18px 22px;border-radius:18px;background:#e5eadf;margin:12px 0;max-width:90%;white-space:pre-wrap}.message.user{margin-left:auto;background:#d8e5ce}.message strong{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}.message p{margin:0}.coach-card{padding:20px;border-left:3px solid #d89a55;background:#f9f8ef;margin-top:18px}.coach-card blockquote{margin:10px 0;font-weight:600}.practice-main h2{font-size:32px;font-weight:500;letter-spacing:-1px}.practice-main textarea{min-height:110px}.practice-main .actions{flex-wrap:wrap}.private{border:1px solid #bec9c1;border-radius:12px;padding:16px;margin:22px 0}.private label{margin-top:0}.practice-setup button{margin-top:12px}.sample-note{font-size:12px;color:#5c6b70}@media(max-width:850px){.practice-layout{grid-template-columns:1fr;gap:20px}.message{max-width:100%}}</style><EdgeHead title="Conversation Practice | EDGE" description="Practise a conversation, negotiation or board discussion with a simulated counterpart."/></head><body><div class="notice">Fictional AI rehearsal, not a prediction. Nothing is automatically saved.</div><div class="shell"><ToolNavigation/><header><div class="eyebrow"><img src="/brand/edge-mark-on-navy.svg" width="32" height="32" alt="EDGE">Conversation Practice</div><h1>Find your words.<br><span>Practise your approach.</span></h1><div class="intro"><p>A difficult conversation, a negotiation or a board review. Try it here, reflect on what you said and take a clearer approach into the real moment.</p><p class="small">Your counterpart is simulated.<br>Your choices and judgement stay yours.</p></div></header><div role="group" class="practice-modes" aria-label="Practice mode"><button data-mode="conversation" aria-pressed="true">Conversation</button><button data-mode="negotiation" aria-pressed="false">Negotiation</button><button data-mode="board" aria-pressed="false">Board review</button></div><main class="practice-layout"><section class="practice-setup"><span class="eyebrow">Set the scene</span><label for="role">Who are you speaking with?</label><input id="role" maxlength="150" placeholder="A colleague, supplier or reviewer"><label for="context">What do they know?</label><textarea id="context" maxlength="5000" placeholder="Describe the shared situation and known constraints."></textarea><small>Only share information the counterpart should know. Use anonymised details.</small><button id="example">Load a fictional example</button><div class="private"><label for="goal">Your private preparation</label><small>For your own reference during practice. Sent to the coach only when you request feedback.</small><textarea id="goal" maxlength="3000" placeholder="Your goal, questions to ask, limits or alternatives."></textarea></div><p id="mode-help" class="small"></p><button id="restart">Start a fresh attempt</button></section><section class="practice-main"><span class="eyebrow">A space to try</span><h2 id="mode-title">Open the conversation.</h2><p class="sample-note">Replies use your shared scenario and this dialogue through our server and OpenAI. Your private preparation is excluded from counterpart replies.</p><div role="log" aria-live="polite" id="dialogue" class="dialogue" aria-label="Practice dialogue"><p class="small">Write the first line as you would say it. You can stop at any time.</p></div><label for="line">Your next line</label><textarea id="line" maxlength="3000" placeholder="What would you say?"></textarea><div class="actions"><button class="primary" id="send">Try this line</button><button id="cancel" hidden>Cancel</button><button id="coach">Review practice with private notes</button></div><p id="status" role="status" class="small"></p><div id="coaching"></div><button id="download">Download dialogue and coaching</button><p class="small">The download excludes your private preparation notes. Refreshing closes this unsaved session.</p></section></main><footer><span>EDGE, created by Adrian Watkins</span><a href="https://adrianwatkins.com/edge" target="_blank" rel="noopener noreferrer">About the framework ↗</a></footer></div><script is:inline src="/journey/practice.js"></script></body></html>
