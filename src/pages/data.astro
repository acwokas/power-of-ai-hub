---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import EcosystemCard from '../components/EcosystemCard.astro';
import { dataUtilities } from '../lib/data-utilities';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The data utility layer',
  url: 'https://democratising.ai/data',
  description:
    'Three independent Singapore data sites built on named public registers, each dated and sourced rather than asserted.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: dataUtilities.map((site, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Dataset',
        name: site.name,
        description: site.description,
        url: site.url,
        creator: { '@type': 'Organization', name: site.name },
        isBasedOn: site.sourceUrl,
      },
    })),
  },
};
---
<BaseLayout
  title="The data utility layer - DEMOCRATISING.AI"
  description="Three independent Singapore data sites built on named public registers: PayLine, COEwatch and DueDate. Real figures, dated and sourced, not marketing copy."
>
  <main>
    <section class="bg-background border-b border-border/60">
      <div class="container mx-auto px-6 max-w-6xl py-16 md:py-24">
        <p class="eyebrow mb-5"><a href="/" class="hover:text-foreground transition-colors">DEMOCRATISING.AI</a> &middot; DATA</p>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.05] mb-6">
          The data utility layer
        </h1>
        <p class="max-w-3xl text-lg md:text-xl text-foreground/85 leading-relaxed">
          Three independent Singapore sites, each built to answer one narrow question from a named
          public register: what a job actually pays, what a COE category actually cleared for,
          when a filing is actually due. No aggregation, no averages standing in for the source.
          Every figure below is dated and linked back to where it came from.
        </p>
        <p class="max-w-3xl text-base text-foreground/70 leading-relaxed mt-4">
          A fourth site, <a href="/#ecosystem" class="underline hover:text-accent">TradeChecked</a>,
          reads the same public registers but is built to answer a single lookup rather than to
          browse. It sits with <a href="/tools" class="underline hover:text-accent">Tools and platforms</a>.
        </p>
      </div>
    </section>

    <section class="py-14 md:py-20">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid gap-6 md:grid-cols-3">
          {dataUtilities.map((site) => (
            <EcosystemCard
              logo={site.logo}
              name={site.name}
              descriptor={site.tagline}
              description={site.description}
              stat={site.stat}
              statLabel={site.statLabel}
              coverageNote={site.coverageNote}
              sourceName={site.sourceName}
              sourceUrl={site.sourceUrl}
              verifiedDate={site.verifiedDate}
              cta={`Visit ${site.name}`}
              url={site.url}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 md:py-20 border-t border-border/60">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Why this exists
        </h2>
        <div class="max-w-3xl text-foreground/85 leading-relaxed space-y-4">
          <p>
            Most of what passes for AI-era content is confident phrasing over unverifiable claims.
            This layer is the opposite bet: narrow tools, each reading one public register, showing
            its working, and staying quiet where the source runs out.
          </p>
          <p>
            That means coverage varies. PayLine's job postings refresh daily because MyCareersFuture
            publishes daily. COEwatch holds the full published series from its source. DueDate's
            entity register is a partial, growing archive of a 2.1 million row dataset, and says so
            on the page rather than rounding up.
          </p>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </main>
  <Footer />
</BaseLayout>
