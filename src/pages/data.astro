---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { dataUtilities } from '../lib/data-utilities';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The data utility layer',
  url: 'https://democratising.ai/data',
  description:
    'Four independent Singapore data sites built on named public registers, each dated and sourced rather than asserted.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: dataUtilities.map((site, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Dataset',
        name: site.name,
        description: site.description,
        url: site.url,
        creator: { '@type': 'Organization', name: site.name },
        isBasedOn: site.sourceUrl,
      },
    })),
  },
};
---
<BaseLayout
  title="The data utility layer - DEMOCRATISING.AI"
  description="Four independent Singapore data sites built on named public registers: PayLine, COEwatch, TradeChecked and DueDate. Real figures, dated and sourced, not marketing copy."
>
  <main>
    <section class="bg-background border-b border-border/60">
      <div class="container mx-auto px-6 max-w-6xl py-16 md:py-24">
        <p class="eyebrow mb-5"><a href="/" class="hover:text-foreground transition-colors">DEMOCRATISING.AI</a> &middot; DATA</p>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.05] mb-6">
          The data utility layer
        </h1>
        <p class="max-w-3xl text-lg md:text-xl text-foreground/85 leading-relaxed">
          Four independent Singapore sites, each built to answer one narrow question from a named
          public register: what a job actually pays, what a COE category actually cleared for,
          whether a contractor actually holds the licence it claims, when a filing is actually due.
          No aggregation, no averages standing in for the source. Every figure below is dated and
          linked back to where it came from.
        </p>
      </div>
    </section>

    <section class="py-14 md:py-20">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2">
          {dataUtilities.map((site) => (
            <div class="group flex flex-col p-7 md:p-8 border border-border bg-card/40 hover:border-accent/60 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <img
                  src={site.logo}
                  alt=""
                  aria-hidden="true"
                  width="40"
                  height="40"
                  class="shrink-0"
                />
                <div>
                  <h2 class="font-serif text-2xl md:text-3xl font-black tracking-tight text-foreground leading-tight">
                    {site.name}
                  </h2>
                  <p class="text-sm text-foreground/70">{site.tagline}</p>
                </div>
              </div>

              <p class="text-base text-foreground leading-relaxed mb-6">
                {site.description}
              </p>

              <div class="mb-6 pb-6 border-b border-border/60">
                <p class="font-serif text-3xl font-black text-accent leading-none mb-1">{site.stat}</p>
                <p class="text-sm text-foreground/70">{site.statLabel}</p>
              </div>

              {site.coverageNote && (
                <p class="text-sm text-foreground/70 leading-relaxed mb-6 border-l-2 border-accent/60 pl-4">
                  {site.coverageNote}
                </p>
              )}

              <div class="mt-auto flex flex-wrap items-center justify-between gap-3">
                <p class="text-xs text-foreground/60">
                  Source: <a href={site.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">{site.sourceName}</a>,
                  read {site.verifiedDate}
                </p>
                <a
                  href={site.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-foreground hover:text-accent font-semibold transition-colors"
                >
                  Visit {site.name}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 md:py-20 border-t border-border/60">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="font-serif text-2xl md:text-3xl font-bold tracking-tight mb-6">
          Why this exists
        </h2>
        <div class="max-w-3xl text-foreground/85 leading-relaxed space-y-4">
          <p>
            Most of what passes for AI-era content is confident phrasing over unverifiable claims.
            This layer is the opposite bet: narrow tools, each reading one public register, showing
            its working, and staying quiet where the source runs out.
          </p>
          <p>
            That means coverage varies. PayLine's job postings refresh daily because MyCareersFuture
            publishes daily. COEwatch and TradeChecked hold the full published series from their
            sources. DueDate's entity register is a partial, growing archive of a 2.1 million row
            dataset, and says so on the page rather than rounding up.
          </p>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </main>
  <Footer />
</BaseLayout>
