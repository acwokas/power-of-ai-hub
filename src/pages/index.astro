---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionText from '../components/SectionText.astro';
import SectionPrinciple from '../components/SectionPrinciple.astro';
import Ecosystem from '../components/Ecosystem.astro';
import SectionPartnerships from '../components/SectionPartnerships.astro';
import AuthorAttribution from '../components/AuthorAttribution.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="DEMOCRATISING.AI - An ecosystem of editorial and applied AI"
  description="An ecosystem of editorial and applied AI, helping people think clearly, act deliberately, and execute with confidence."
>
  <main>
    <Hero />
    <SectionText />
    <SectionPrinciple />
    <Ecosystem />
    <SectionPartnerships />
    <AuthorAttribution />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
