---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../lib/site-meta';
import Hero from '../components/Hero.astro';
import SectionText from '../components/SectionText.astro';
import SectionPrinciple from '../components/SectionPrinciple.astro';
import Ecosystem from '../components/Ecosystem.astro';
import SectionPartnerships from '../components/SectionPartnerships.astro';
import AuthorAttribution from '../components/AuthorAttribution.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
>
  <main>
    <Hero />
    <SectionText />
    <SectionPrinciple />
    <Ecosystem />
    <SectionPartnerships />
    <AuthorAttribution />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
